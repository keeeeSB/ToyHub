<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header text-center">
        <h3><%= @toy.name %></h3>
      </div>
      <div class="card-body">
        <p class="mb-3"><strong>価格:</strong> ¥<%= number_with_delimiter(@toy.price.to_i) %></p>
        <p class="mb-3"><strong>説明:</strong></p>
        <p><%= @toy.description %></p>
      </div>
      <div class="card-footer d-flex justify-content-end">
        <%= link_to "編集", edit_toy_path(@toy), class: "btn btn-warning btn-sm me-2" %>
        <%= link_to "削除", toy_path(@toy),
                            data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm me-2" %>
      </div>
    </div>

    <div class="mt-4">
      <% if @toy.reviews.present? %>
        <h4 class="mb-3">レビュー</h4>
        <% @toy.reviews.each do |review| %>
          <div class="card mb-3">
            <div class="card-body">
              <p><strong><%= review.user.name %></strong> - <%= review.created_at.strftime("%Y年%m月%d日 %H:%M") %></p>
              <p><%= review.comment %></p>
              <div class="star-display">
                <% 5.times do |i| %>
                  <% if i < review.rating %>
                    <span class="star filled">★</span>
                  <% else %>
                    <span class="star">★</span>
                  <% end %>
                <% end %>
              </div>
              <% if review.user == current_user %>
                <div class="d-flex justify-content-end">
                  <%= link_to "編集", edit_user_review_path(current_user, review), class: "btn btn-sm btn-outline-warning me-2" %>
                  <%= link_to "削除", user_review_path(current_user, review), 
                                      data: { "turbo-method": :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if logged_in? %>
      <div class="mt-4">
        <% if current_user.review.nil? %>
          <h4 class="mb-3">レビューを投稿する</h4>
          <%= form_with(model: @toy, url: user_review_path(current_user), local: true) do |f| %>
            <%= render "shared/error_messages", object: @toy %>

            <div class="mb-3">
              <%= f.label :rating, "評価（1~5）", class: "form-label" %>
              <div class="star-rating">
                <% 5.downto(1) do |i| %>
                  <%= f.radio_button :rating, i, id: "star#{i}" %>
                  <label for="star<%= i %>" class="star">
                    ★
                  </label>
                <% end %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :comment, "コメント", class: "form-label" %>
              <%= f.text_area :comment, class: "form-control" %>
            </div>

            <div class="d-flex justify-content-end">
              <%= f.submit "投稿", class: "btn btn-outline-primary" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">既にレビューを投稿済みです。</p>
        <% end %>
      </div>
    <% else %>
      <p class="text-center mt-4">レビューを投稿するには<%= link_to "ログイン", login_path %>してください。</p>
    <% end %>
  </div>
</div>
